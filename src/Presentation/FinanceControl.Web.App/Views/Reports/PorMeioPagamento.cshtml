@{
    ViewData["Title"] = "Relatório por meio de pagamento";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">Relatório por meio de pagamento</h2>
        <p class="text-muted mb-0">Consulte as movimentações de acordo com a forma de pagamento utilizada.</p>
    </div>

    <a class="btn btn-outline-primary" href="~/relatorios">Voltar para relatórios</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <h5 class="card-title mb-2">Análise por forma de pagamento</h5>
        <p class="text-muted mb-0">
            Esta área foi preparada para apresentar os dados financeiros agrupados por Pix, dinheiro,
            cartão de crédito, cartão de débito e demais meios de pagamento cadastrados.
        </p>
    </div>
</div>
