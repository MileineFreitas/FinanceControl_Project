@model FinanceControl.Web.Models.ViewModels.Reports.TransactionReportViewModel
@{
    ViewData["Title"] = "Relatório de transações";
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var periodoCapitalizado = char.ToUpper(Model.PeriodoLabel[0], cultura) + Model.PeriodoLabel[1..];
}
@section Styles {
    <link rel="stylesheet" href="~/css/reports-category.css" asp-append-version="true" />
}

<div class="rep-cat">
    <header class="rep-cat__head">
        <div>
            <h1 class="rep-cat__title">Relatório de transações</h1>
            <p class="rep-cat__sub">Visão consolidada dos lançamentos do período com gráficos e histórico detalhado.</p>
        </div>
        <form method="get" class="rep-cat__filter" aria-label="Filtrar por mês">
            <label for="mes" class="rep-cat__filter-label">Período</label>
            <select id="mes" name="mes" class="rep-cat__filter-select" onchange="this.form.submit()">
                @foreach (var opt in Model.MonthOptions)
                {
                    if (opt.Selected)
                    {
                        <option value="@opt.Value" selected>@char.ToUpper(opt.Label[0], cultura)@opt.Label[1..]</option>
                    }
                    else
                    {
                        <option value="@opt.Value">@char.ToUpper(opt.Label[0], cultura)@opt.Label[1..]</option>
                    }
                }
            </select>
        </form>
    </header>

    @if (!string.IsNullOrEmpty(Model.ApiMensagem))
    {
        <p class="rep-cat__banner" role="status">@Model.ApiMensagem</p>
    }

    <p class="rep-cat__period">Período: <strong>@periodoCapitalizado</strong> · <strong>@Model.TotalTransacoes</strong> transação(ões)</p>

    <div class="rep-cat__metrics rep-cat__metrics--four" aria-label="Totais do período">
        <article class="rep-metric rep-metric--income">
            <p class="rep-metric__label">Receitas</p>
            <p class="rep-metric__value">@Model.TotalReceitasFmt</p>
        </article>
        <article class="rep-metric rep-metric--expense">
            <p class="rep-metric__label">Despesas</p>
            <p class="rep-metric__value">@Model.TotalDespesasFmt</p>
        </article>
        <article class="rep-metric @(Model.SaldoNegativo ? "rep-metric--expense" : "rep-metric--income")">
            <p class="rep-metric__label">Saldo do período</p>
            <p class="rep-metric__value">@Model.SaldoFmt</p>
        </article>
        <article class="rep-metric">
            <p class="rep-metric__label">Lançamentos</p>
            <p class="rep-metric__value">@Model.TotalTransacoes</p>
        </article>
    </div>

    @if (!Model.TemDados)
    {
        <div class="rep-cat__empty">
            <p>Nenhuma transação encontrada em <strong>@periodoCapitalizado</strong>.</p>
            <p class="rep-cat__empty-hint">Selecione outro mês ou cadastre transações para visualizar os gráficos.</p>
        </div>
    }
    else
    {
        <div class="rep-cat__charts">
            <section class="rep-panel" aria-labelledby="rep-tipo-heading">
                <div class="rep-panel__head">
                    <h2 id="rep-tipo-heading">Receitas vs despesas</h2>
                    <p>Proporção entre entradas e saídas no mês.</p>
                </div>
                <div class="rep-panel__chart rep-panel__chart--doughnut">
                    <canvas id="rep-chart-tipo" aria-label="Gráfico receitas e despesas"></canvas>
                </div>
            </section>

            <section class="rep-panel" aria-labelledby="rep-daily-heading">
                <div class="rep-panel__head">
                    <h2 id="rep-daily-heading">Movimento diário</h2>
                    <p>Receitas e despesas por dia do mês selecionado.</p>
                </div>
                <div class="rep-panel__chart rep-panel__chart--daily">
                    <canvas id="rep-chart-diario" aria-label="Gráfico de movimento diário"></canvas>
                </div>
            </section>
        </div>

        <section class="rep-panel rep-panel--table" aria-labelledby="rep-tx-table-heading">
            <div class="rep-panel__head">
                <h2 id="rep-tx-table-heading">Histórico de transações</h2>
                <p>Todos os lançamentos registrados no período.</p>
            </div>
            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th scope="col">Data</th>
                            <th scope="col">Descrição</th>
                            <th scope="col">Categoria</th>
                            <th scope="col">Meio pagamento</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.DateFmt</td>
                                <td>@row.Description</td>
                                <td>@row.CategoryName</td>
                                <td>@row.PaymentMethodName</td>
                                <td>
                                    <span class="rep-tag @(row.IsReceita ? "rep-tag--income" : "rep-tag--expense")">@row.TypeLabel</span>
                                </td>
                                <td class="@(row.IsReceita ? "rep-table__income" : "rep-table__expense")">@row.ValueFmt</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@section Scripts {
    @if (Model.TemDados)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" crossorigin="anonymous"></script>
        <script>
            window.repCharts = {
                mode: 'transactions',
                tipo: @Html.Raw(Model.ChartTipoJson),
                diario: @Html.Raw(Model.ChartDiarioJson)
            };
        </script>
        <script src="~/js/reports-charts.js" asp-append-version="true"></script>
    }
}
