@{
    ViewData["Title"] = "Relatório de transação";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">Relatório de transação</h2>
        <p class="text-muted mb-0">Acompanhe as movimentações registradas e consulte o histórico transacional.</p>
    </div>

    <a class="btn btn-outline-primary" href="~/relatorios">Voltar para relatórios</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <h5 class="card-title mb-2">Análise transacional</h5>
        <p class="text-muted mb-0">
            Esta visualização foi organizada para exibir o comportamento das transações, apoiando a leitura
            do histórico de lançamentos e das movimentações financeiras cadastradas.
        </p>
    </div>
</div>
