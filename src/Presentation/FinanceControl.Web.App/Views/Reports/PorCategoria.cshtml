@{
    ViewData["Title"] = "Relatório por categoria";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">Relatório por categoria</h2>
        <p class="text-muted mb-0">Veja os resultados financeiros agrupados conforme as categorias registradas.</p>
    </div>

    <a class="btn btn-outline-primary" href="~/relatorios">Voltar para relatórios</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <h5 class="card-title mb-2">Análise por categoria</h5>
        <p class="text-muted mb-0">
            Esta página centraliza a consulta de receitas e despesas por categoria, facilitando a leitura
            dos grupos com maior impacto no seu controle financeiro.
        </p>
    </div>
</div>
