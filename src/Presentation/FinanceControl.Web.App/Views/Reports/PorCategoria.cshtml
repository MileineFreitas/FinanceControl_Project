@model FinanceControl.Web.Models.ViewModels.Reports.GroupedReportViewModel
@{
    ViewData["Title"] = Localizer["Reports.ByCategoryTitle"].Value;
}
@section Styles {
    <link rel="stylesheet" href="~/css/reports-category.css" asp-append-version="true" />
}

<partial name="_GroupedReportBody" model="Model" />

@section Scripts {
    @if (Model.TemDados)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" crossorigin="anonymous"></script>
        <script>
            window.repCharts = {
                mode: 'grouped',
                locale: '@Model.Idioma',
                currency: '@Model.Moeda',
                despesas: @Html.Raw(Model.ChartDespesasJson),
                comparativo: @Html.Raw(Model.ChartComparativoJson)
            };
        </script>
        <script src="~/js/reports-charts.js" asp-append-version="true"></script>
    }
}
