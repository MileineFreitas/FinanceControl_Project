<!DOCTYPE html>
<html lang="@User.GetFinancialPreferences().Idioma">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Cashly</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/cashly-favicon.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/cashly-favicon.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/cashly-favicon.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wealth-terminal-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wealth-terminal-sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header-dropdown-fix.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="page page--wealth" id="fc-page-root">
        @await Component.InvokeAsync("MainHeader")
        <button type="button" class="fc-sidebar-backdrop" data-fc-sidebar-backdrop tabindex="-1" aria-label="Fechar menu"></button>
        <div class="page-shell">
            <aside class="sidebar fc-wt-sidebar" id="fc-sidebar">
                <partial name="_Nav" />
            </aside>
            <main class="main-area">
                <article class="content px-4">
                    @RenderBody()
                </article>
            </main>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
