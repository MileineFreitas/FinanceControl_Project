@model FinanceControl.Web.Models.ViewModels.Shared.MainHeaderViewModel

<header class="header">
    <div class="header__container">
        <div class="header__start">
            <button type="button" class="header__menu-toggle" data-fc-mobile-nav-toggle aria-label="Abrir ou fechar menu">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>

            <a class="header__logo" href="~/home">
                <span class="header__logo-icon" aria-hidden="true">⚡</span>
                <span class="header__logo-text">WEALTHTERMINAL</span>
            </a>
        </div>

        <div class="header__search-global-wrap" id="fc-global-search-wrap">
            <label class="header__search header__search--wide">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" stroke-width="2"/>
                    <path d="M20 20l-3-3" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <input type="search"
                       id="fc-global-search-input"
                       class="header__search-input"
                       placeholder="Buscar páginas do sistema…"
                       autocomplete="off"
                       aria-label="Buscar telas e menus"
                       aria-controls="fc-global-search-results"
                       aria-expanded="false"
                       role="combobox" />
            </label>
            <ul class="fc-global-search-results is-hidden" id="fc-global-search-results" role="listbox" aria-label="Resultados"></ul>
        </div>

        <div class="header__actions">
            <div class="header-notifications" id="fc-header-notifications">
                <button type="button"
                        class="header__icon-btn header-notifications__toggle"
                        data-fc-notifications-toggle
                        aria-expanded="false"
                        aria-haspopup="true"
                        title="Notificações"
                        aria-label="Notificações">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke-width="2" stroke-linecap="round"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <span class="header-notifications__badge" data-fc-notifications-badge>2</span>
                </button>

                <button type="button" class="header-dropdown-backdrop" tabindex="-1" aria-label="Fechar notificações" data-fc-notifications-close></button>
                <div class="header-dropdown header-notifications-dropdown" role="region" aria-label="Painel de notificações">
                    <div class="header-dropdown-header header-notifications__head">
                        <p class="header-dropdown-username">Notificações</p>
                        <button type="button" class="header-notifications__mark-read" data-fc-notifications-mark-read>
                            Marcar todas como lidas
                        </button>
                    </div>
                    <ul class="header-notifications__list" role="list">
                        <li class="header-notifications__item header-notifications__item--unread" role="listitem">
                            <span class="header-notifications__dot" aria-hidden="true"></span>
                            <div class="header-notifications__body">
                                <p class="header-notifications__title">Orçamento de Alimentação</p>
                                <p class="header-notifications__text">Você atingiu 85% do limite mensal nesta categoria.</p>
                                <time class="header-notifications__time" datetime="2026-05-24T10:30:00">Há 2 horas</time>
                            </div>
                        </li>
                        <li class="header-notifications__item header-notifications__item--unread" role="listitem">
                            <span class="header-notifications__dot" aria-hidden="true"></span>
                            <div class="header-notifications__body">
                                <p class="header-notifications__title">Nova transação registrada</p>
                                <p class="header-notifications__text">Despesa de R$ 120,00 em Transporte foi lançada.</p>
                                <time class="header-notifications__time" datetime="2026-05-23T18:15:00">Ontem</time>
                            </div>
                        </li>
                        <li class="header-notifications__item" role="listitem">
                            <div class="header-notifications__body">
                                <p class="header-notifications__title">Resumo semanal disponível</p>
                                <p class="header-notifications__text">Confira o resumo das suas finanças na tela de relatórios.</p>
                                <time class="header-notifications__time" datetime="2026-05-22T09:00:00">22 mai</time>
                            </div>
                        </li>
                    </ul>
                    <div class="header-notifications__footer">
                        <a class="header-notifications__footer-link" href="~/relatorios">Ver todas as notificações</a>
                    </div>
                </div>
            </div>
            <div class="header-profile" id="fc-header-profile">
                <button type="button"
                        class="header__profile-btn header-profile-btn border-0"
                        data-fc-profile-toggle
                        aria-expanded="false"
                        aria-haspopup="true"
                        title="Menu do perfil"
                        aria-label="Menu do perfil">
                    <img src="@Model.AvatarSrc" alt="" class="header__profile-img" width="40" height="40" />
                </button>

                <button type="button" class="header-dropdown-backdrop" tabindex="-1" aria-label="Fechar menu" data-fc-profile-close></button>
                <div class="header-dropdown header-profile-dropdown" role="menu">
                    <div class="header-dropdown-header">
                        <p class="header-dropdown-username">@Model.DisplayName</p>
                    </div>
                    <a class="header-dropdown-item" href="~/perfil" role="menuitem">
                        <svg class="dropdown-item-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                        </svg>
                        <span>Meu Perfil</span>
                    </a>
                    <a class="header-dropdown-item" href="~/conta/configuracao" role="menuitem">
                        <svg class="dropdown-item-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.52-.4-1.08-.73-1.69-.98l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.61.25-1.17.59-1.69.98l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.52.4 1.08.73 1.69.98l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.61-.25 1.17-.59 1.69-.98l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                        </svg>
                        <span>Configurações</span>
                    </a>
                    <a class="header-dropdown-item" href="~/conta/privacidade" role="menuitem">
                        <svg class="dropdown-item-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
                        </svg>
                        <span>Privacidade</span>
                    </a>
                    <div class="header-dropdown-divider"></div>
                    <form method="post" action="~/logout" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="header-dropdown-item header-dropdown-item-logout w-100 border-0 bg-transparent text-start" role="menuitem">
                            <svg class="dropdown-item-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="currentColor" d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" />
                            </svg>
                            <span>Sair</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>
