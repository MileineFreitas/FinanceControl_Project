@using System.Globalization
@model FinanceControl.Web.Models.ViewModels.Home.HomeIndexViewModel
@{
    ViewData["Title"] = Localizer["Home.Title"].Value;
}
@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard-home.css" asp-append-version="true" />
}

<div class="dash-wt">
    @if (!string.IsNullOrEmpty(Model.ApiMensagem))
    {
        <p class="dash-api-banner" role="status">@Model.ApiMensagem</p>
    }
    <div class="dash-wt__metrics" aria-label="@Localizer["Home.PeriodIndicators"]">
        @foreach (var m in Model.Metrics)
        {
            <article class="dash-metric">
                <div class="dash-metric__icon" aria-hidden="true">
                    @switch (m.IconSvgClass)
                    {
                        case "chart":
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 19V5"/><path d="M4 19h16"/><path d="M8 17V9"/><path d="M12 17v-5"/><path d="M16 17v-9"/></svg>
                            break;
                        case "bank":
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
                            break;
                        default:
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.35-3.39-3.83V5H10v2.16c-1.97.41-3.6 1.36-3.6 3.15 0 2.19 1.77 3.23 4.6 3.9 2.48.59 3 1.35 3 2.33 0 .92-.71 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
                            </svg>
                            break;
                    }
                </div>
                <p class="dash-metric__label">@m.Title</p>
                <p class="dash-metric__value @(m.IsSaldo ? (m.TrendNegative ? "fc-balance--negative" : "fc-balance--positive") : null)">@m.Value</p>
                <p class="dash-metric__trend @(m.TrendNegative ? "dash-metric__trend--bad" : "dash-metric__trend--good")">@m.TrendText</p>
            </article>
        }
    </div>

    <section class="dash-panel" aria-labelledby="dash-resumo-heading">
        <div class="dash-panel__head">
            <div>
                <h2 id="dash-resumo-heading">@Localizer["Home.TxSummary"]</h2>
                <p class="dash-panel__sub">@Localizer["Home.TxSummarySub"]</p>
            </div>
            <div class="dash-panel__tools">
                <div class="dash-toggle" role="group" aria-label="@Localizer["Home.PeriodSummary"]">
                    <button type="button" class="is-active" data-dash-period="mensal">@Localizer["Home.PeriodMonthly"]</button>
                    <button type="button" data-dash-period="semanal">@Localizer["Home.PeriodWeekly"]</button>
                </div>
                <label class="dash-inline-search">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke-width="2"/><path d="M20 20l-3-3" stroke-width="2" stroke-linecap="round"/></svg>
                    <input type="search" id="dash-tx-filter" placeholder="@Localizer["Home.FilterTx"]" autocomplete="off" aria-label="@Localizer["Home.FilterTxLabel"]" />
                </label>
                <button type="button" class="dash-filter-btn" title="@Localizer["Home.MoreFilters"]" aria-label="@Localizer["Home.OpenFilters"]">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M22 3H2l8 9v9l4 2v-11l8-9z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </div>
        </div>

        <div class="dash-table-wrap">
            <table class="dash-table" id="dash-tx-table">
                <thead>
                    <tr>
                        <th scope="col" aria-sort="descending">
                            <button type="button" class="dash-th-sort is-active" data-sort-key="date" data-sort-default="desc" aria-label="@Localizer["Home.SortByDate"]">
                                @Localizer["Home.ColDate"] <span class="dash-th-sort__icon is-desc" aria-hidden="true"></span>
                            </button>
                        </th>
                        <th scope="col" aria-sort="none">
                            <button type="button" class="dash-th-sort" data-sort-key="title" data-sort-default="asc" aria-label="@Localizer["Home.SortByDescription"]">
                                @Localizer["Home.ColDescription"] <span class="dash-th-sort__icon is-none" aria-hidden="true"></span>
                            </button>
                        </th>
                        <th scope="col" aria-sort="none">
                            <button type="button" class="dash-th-sort" data-sort-key="category" data-sort-default="asc" aria-label="@Localizer["Home.SortByCategory"]">
                                @Localizer["Home.ColCategory"] <span class="dash-th-sort__icon is-none" aria-hidden="true"></span>
                            </button>
                        </th>
                        <th scope="col" style="text-align:right" aria-sort="none">
                            <button type="button" class="dash-th-sort dash-th-sort--right" data-sort-key="value" data-sort-default="desc" aria-label="@Localizer["Home.SortByValue"]">
                                @Localizer["Home.ColValue"] <span class="dash-th-sort__icon is-none" aria-hidden="true"></span>
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TransacoesResumo.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="dash-empty-state">
                                @Localizer["Home.EmptyTx"]
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in Model.TransacoesResumo)
                        {
                            var filterBlob = $"{row.Titulo} {row.LinhaSecundaria} {row.CategoriaBadge}".ToLowerInvariant();
                            <tr data-dash-filter="@filterBlob"
                                data-sort-date="@row.DataOrdenacao"
                                data-sort-title="@row.Titulo.ToLowerInvariant()"
                                data-sort-category="@row.CategoriaBadge.ToLowerInvariant()"
                                data-sort-value="@row.ValorOrdenacao.ToString(CultureInfo.InvariantCulture)">
                                <td>@row.DataHora</td>
                                <td>
                                    <div class="dash-table__desc">
                                        <div class="dash-table__icon">
                                            <span class="material-symbols-outlined" aria-hidden="true">@row.IconMaterial</span>
                                        </div>
                                        <div>
                                            <p class="dash-table__title">@row.Titulo</p>
                                            <p class="dash-table__meta">@row.LinhaSecundaria</p>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="dash-badge">@row.CategoriaBadge</span></td>
                                <td style="text-align:right" class="dash-table__valor @(row.IsReceita ? "dash-table__valor--in" : "dash-table__valor--out")">@row.Valor</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <footer class="dash-panel__foot">
            <span id="dash-tx-count" data-list-total="@Model.TransacoesMostradas" data-app-total="@Model.TotalTransacoes">@Localizer["Home.ShowingTx", Model.TransacoesMostradas, Model.TotalTransacoes]</span>
            <div class="dash-pager">
                <button type="button" aria-label="@Localizer["Home.PrevPage"]" disabled>&lsaquo;</button>
                <button type="button" aria-label="@Localizer["Home.NextPage"]">&rsaquo;</button>
            </div>
        </footer>
    </section>
</div>

@section Scripts {
    <script>
        window.dashLocale = '@Model.Idioma';
    </script>
    <script src="~/js/dashboard-home.js" asp-append-version="true"></script>
}
