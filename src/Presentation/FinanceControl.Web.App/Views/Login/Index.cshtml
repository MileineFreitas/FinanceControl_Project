@model FinanceControl.Web.Models.ViewModels.Auth.LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Entrar";
}
@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-wrapper">
    <div class="login-left">
        <div class="brand">
            <img src="~/cashly-logo.png" alt="Cashly" class="brand-logo" />
        </div>

        <div class="left-content">
            <h1 class="left-title">
                Controle suas <span class="accent">finanças</span> com precisão.
            </h1>
            <p class="left-subtitle">
                Gerencie receitas, despesas e categorias em um só lugar.
                Simples, rápido e seguro.
            </p>

            <div class="balance-card">
                <div class="feature-list">
                    <div class="feature-item">
                        <span class="feature-check">✓</span>
                        Relatórios e dashboards em tempo real
                    </div>
                    <div class="feature-item">
                        <span class="feature-check">✓</span>
                        Categorize receitas e despesas facilmente
                    </div>
                    <div class="feature-item">
                        <span class="feature-check">✓</span>
                        Seus dados sempre protegidos
                    </div>
                </div>
            </div>
        </div>

        <div class="left-footer">
            © 2026 Cashly. Todos os direitos reservados.
        </div>
    </div>

    <div class="login-right">
        <p class="form-eyebrow">Bem-vindo de volta</p>
        <h1 class="form-title">Entre na sua conta</h1>
        <p class="form-desc">Acesse seu painel e continue no controle das suas finanças.</p>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert-box" role="alert">@Model.Message</div>
        }

        <form method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="field-group">
                <label class="field-label" asp-for="LoginRequest.Email">Email</label>
                <div class="input-icon">
                    <span class="icon">✉</span>
                    <input asp-for="LoginRequest.Email" class="form-control" placeholder="seu@email.com" autocomplete="username" />
                </div>
                <span asp-validation-for="LoginRequest.Email" class="text-danger"></span>
            </div>

            <div class="field-group">
                <label class="field-label" asp-for="LoginRequest.Password">Senha</label>
                <div class="input-icon">
                    <span class="icon">🔒</span>
                    <input asp-for="LoginRequest.Password" type="password" class="form-control" placeholder="sua senha" autocomplete="current-password" />
                </div>
                <span asp-validation-for="LoginRequest.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-login">Entrar</button>

            <div class="divider">ou</div>

            <div class="register-account">
                <a href="/register" class="btn-register">Criar uma conta</a>
            </div>
        </form>
    </div>
</div>
