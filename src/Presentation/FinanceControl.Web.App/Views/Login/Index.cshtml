@model FinanceControl.Web.Models.ViewModels.Auth.LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = Localizer["Auth.LoginTitle"].Value;
}
@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-wrapper">
    <div class="login-left">
        <div class="brand">
            <img src="~/cashly-logo.png" alt="@Localizer["AppName"]" class="brand-logo" />
        </div>

        <div class="left-content">
            <h1 class="left-title">
                @Html.Raw(string.Format(Localizer["Auth.LoginHero"].Value, $"<span class=\"accent\">{Localizer["Auth.LoginHeroAccent"]}</span>"))
            </h1>
            <p class="left-subtitle">
                @Localizer["Auth.LoginHeroSub"]
            </p>

            <div class="balance-card">
                <div class="feature-list">
                    <div class="feature-item">
                        <span class="feature-check">✓</span>
                        @Localizer["Auth.FeatureReports"]
                    </div>
                    <div class="feature-item">
                        <span class="feature-check">✓</span>
                        @Localizer["Auth.FeatureCategories"]
                    </div>
                    <div class="feature-item">
                        <span class="feature-check">✓</span>
                        @Localizer["Auth.FeatureSecurity"]
                    </div>
                </div>
            </div>
        </div>

        <div class="left-footer">
            @Localizer["Common.Copyright"]
        </div>
    </div>

    <div class="login-right">
        <p class="form-eyebrow">@Localizer["Auth.WelcomeBack"]</p>
        <h1 class="form-title">@Localizer["Auth.SignInTitle"]</h1>
        <p class="form-desc">@Localizer["Auth.SignInSub"]</p>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert-box" role="alert">@Model.Message</div>
        }

        <form method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="field-group">
                <label class="field-label" asp-for="LoginRequest.Email">@Localizer["Auth.Email"]</label>
                <div class="input-icon">
                    <span class="icon">✉</span>
                    <input asp-for="LoginRequest.Email" class="form-control" placeholder="@Localizer["Auth.EmailPlaceholder"]" autocomplete="username" />
                </div>
                <span asp-validation-for="LoginRequest.Email" class="text-danger"></span>
            </div>

            <div class="field-group">
                <label class="field-label" asp-for="LoginRequest.Password">@Localizer["Auth.Password"]</label>
                <div class="input-icon">
                    <span class="icon">🔒</span>
                    <input asp-for="LoginRequest.Password" type="password" class="form-control" placeholder="@Localizer["Auth.PasswordPlaceholder"]" autocomplete="current-password" />
                </div>
                <span asp-validation-for="LoginRequest.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-login">@Localizer["Auth.SignIn"]</button>

            <div class="divider">@Localizer["Common.Or"]</div>

            <div class="register-account">
                <a href="/register" class="btn-register">@Localizer["Auth.CreateAccount"]</a>
            </div>
        </form>
    </div>
</div>
