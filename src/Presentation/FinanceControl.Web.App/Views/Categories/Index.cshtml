@model CategoryViewModel
@{
    ViewData["Title"] = "Categorias";
    var showModal = Model.ModalAberto || !string.IsNullOrEmpty(Model.ErroModal);
}
@section Styles {
    <link rel="stylesheet" href="~/css/cadastros-wt.css" asp-append-version="true" />
}

<div class="wt-cadastro" id="categories-page">
    <div class="wt-cadastro__inner">
        @if (!string.IsNullOrEmpty(Model.ErroPagina))
        {
            <div class="wt-alert wt-alert--error">@Model.ErroPagina</div>
        }
        @if (Model.UsandoDadosDemo)
        {
            <div class="wt-alert">Sem dados da API � exibindo exemplos locais.</div>
        }

        <header class="wt-page-head">
            <div>
                <p class="wt-page-kicker">FinanceControl</p>
                <h1 class="wt-page-title">Categorias</h1>
                <p class="wt-page-sub">Cadastre categorias para classificar seus lan�amentos. Receita ou despesa � definida na transa��o.</p>
            </div>
            <button type="button" class="wt-btn wt-btn--primary wt-btn--glow" data-wt-modal-open="wt-cat-modal">
                + Nova categoria
            </button>
        </header>

        <form method="get" class="wt-filters" style="margin-bottom:1rem">
            <div class="wt-field" style="flex:1">
                <label for="busca">Buscar</label>
                <input class="wt-input" id="busca" name="busca" value="@Model.Busca" placeholder="Nome da categoria..." />
            </div>
            <button type="submit" class="wt-btn wt-btn--outline">Filtrar</button>
        </form>

        <section class="wt-card-panel">
            <div class="wt-cards-grid" id="categories-grid">
                @foreach (var cat in Model.Categorias)
                {
                    <div class="wt-cat-card">
                        <div class="wt-card-icon">@cat.Icone</div>
                        <div class="wt-card-name">@cat.Nome</div>
                        @if (!string.IsNullOrWhiteSpace(cat.Descricao))
                        {
                            <p class="wt-hint" style="margin-top:.35rem">@cat.Descricao</p>
                        }
                        @if (cat.CategoryId is int cid && cid > 0)
                        {
                            <div style="display:flex;gap:.5rem;margin-top:.75rem;flex-wrap:wrap">
                                <a asp-action="Edit" asp-route-id="@cid" asp-route-busca="@Model.Busca" class="wt-btn wt-btn--ghost" title="Editar">?</a>
                                <form method="post" asp-action="Delete" asp-route-id="@cid" asp-route-busca="@Model.Busca" class="js-category-delete" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="wt-btn wt-btn--outline">Excluir</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="wt-pagination" style="margin-top:1rem">
                <span>@Model.Categorias.Count categoria(s)</span>
            </div>
        </section>
    </div>
</div>

<div class="wt-modal-overlay @(showModal ? null : "is-hidden")" id="wt-cat-modal">
    <div class="wt-modal" data-wt-stop-propagation>
        <form method="post" asp-action="Save" id="category-form" class="wt-cat-form">
            @Html.AntiForgeryToken()
            @if (Model.EditingId is int editId)
            {
                <input type="hidden" name="EditingId" value="@editId" />
            }
            <input type="hidden" name="Busca" value="@Model.Busca" />
            <div class="wt-modal__head">
                <h2 class="wt-modal__title">@(Model.EditingId.HasValue ? "Editar categoria" : "Nova categoria")</h2>
                <button type="button" class="wt-modal__close" data-wt-close-modal>?</button>
            </div>
            <div class="wt-cat-form__fields">
                <div class="wt-cat-form__field">
                    <label class="wt-label" asp-for="Input.CategoryName">Nome da categoria</label>
                    <input class="wt-input" asp-for="Input.CategoryName" placeholder="Ex.: Assinatura tech" />
                </div>
                <div class="wt-cat-form__field">
                    <label class="wt-label" asp-for="Input.CategoryDescription">Descri��o</label>
                    <textarea class="wt-input wt-textarea" asp-for="Input.CategoryDescription" rows="3" placeholder="Opcional"></textarea>
                </div>
                <div class="wt-cat-form__field">
                    <span class="wt-label">Selecionar �cone</span>
                    <input type="hidden" asp-for="Input.Icon" id="category-icon-value" />
                    <div class="wt-icone-grid" id="category-icon-grid" role="listbox" aria-label="�cones da categoria">
                        @foreach (var icone in Model.IconesDisponiveis)
                        {
                            var selected = icone == Model.Input.Icon ? " wt-icone-opt--selected" : "";
                            <span class="wt-icone-opt@selected" role="option" tabindex="0" data-category-icon="@icone" aria-label="�cone @icone" aria-selected="@(icone == Model.Input.Icon ? "true" : "false")">@icone</span>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.ErroModal))
                {
                    <p class="wt-alert wt-alert--error">@Model.ErroModal</p>
                }
            </div>
            <div class="wt-modal__footer">
                <a asp-action="Index" asp-route-busca="@Model.Busca" class="wt-btn wt-btn--outline">Cancelar</a>
                <button type="submit" class="wt-btn wt-btn--primary wt-btn--glow">@(Model.EditingId.HasValue ? "Salvar" : "Criar categoria")</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/cadastros-wt.js" asp-append-version="true"></script>
    <script src="~/js/categories.js" asp-append-version="true"></script>
}
