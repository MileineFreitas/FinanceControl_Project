@model FinanceControl.Web.Models.ViewModels.Transactions.TransactionIndexViewModel
@{
    ViewData["Title"] = "Transações";
    var showModal = Model.ModalAberto || !string.IsNullOrEmpty(Model.ErroModal);
}
@section Styles {
    <link rel="stylesheet" href="~/css/cadastros-wt.css" asp-append-version="true" />
}

<div class="wt-cadastro">
    <div class="wt-cadastro__inner">
        @if (!string.IsNullOrEmpty(Model.ApiMensagem))
        {
            <div class="wt-alert">@Model.ApiMensagem</div>
        }

        <header class="wt-page-head">
            <div>
                <p class="wt-page-kicker">FinanceControl</p>
                <h1 class="wt-page-title">Transações</h1>
                <p class="wt-page-sub">Histórico completo de movimentações financeiras.</p>
            </div>
            <button type="button" class="wt-btn wt-btn--primary wt-btn--glow" data-wt-modal-open="wt-tx-modal">
                + Cadastrar transação
            </button>
        </header>

        <form method="get" class="wt-filters">
            <input type="hidden" name="OrdenarPor" value="@Model.OrdenarPor" />
            <input type="hidden" name="Ordem" value="@Model.Ordem" />
            <div class="wt-field">
                <label for="FiltroTipo">Tipo</label>
                <select class="wt-select" id="FiltroTipo" name="FiltroTipo" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.FiltroTipo))">Todos</option>
                    <option value="1" selected="@(Model.FiltroTipo == "1")">Receita</option>
                    <option value="2" selected="@(Model.FiltroTipo == "2")">Despesa</option>
                </select>
            </div>
            <div class="wt-field">
                <label for="FiltroCategoriaId">Categoria</label>
                <select class="wt-select" id="FiltroCategoriaId" name="FiltroCategoriaId" onchange="this.form.submit()">
                    <option value="">Todas</option>
                    @foreach (var c in Model.CategoriasOpcoes)
                    {
                        <option value="@c.Id" selected="@(Model.FiltroCategoriaId == c.Id ? true : false)">@c.Icone @c.Nome</option>
                    }
                </select>
            </div>
            <div class="wt-field" style="flex:1;min-width:12rem">
                <label for="Busca">Buscar</label>
                <input class="wt-input" type="search" id="Busca" name="Busca" value="@Model.Busca" placeholder="Descrição, categoria ou meio de pagamento..." />
            </div>
            <button type="submit" class="wt-btn wt-btn--outline">Filtrar</button>
        </form>

        <section class="wt-card-panel">
            <div class="wt-table-wrap">
                <table class="wt-table">
                    <thead>
                        <tr>
                            <th>
                                <a class="wt-th-sort @(Model.ColunaOrdenada("data") ? "is-active" : null)" asp-controller="Transactions" asp-action="Index" asp-all-route-data="@Model.RotasOrdenacao("data")">
                                    Data <span class="wt-th-sort__icon">@Model.IconeOrdenacao("data")</span>
                                </a>
                            </th>
                            <th>
                                <a class="wt-th-sort @(Model.ColunaOrdenada("descricao") ? "is-active" : null)" asp-controller="Transactions" asp-action="Index" asp-all-route-data="@Model.RotasOrdenacao("descricao")">
                                    Descrição <span class="wt-th-sort__icon">@Model.IconeOrdenacao("descricao")</span>
                                </a>
                            </th>
                            <th>
                                <a class="wt-th-sort @(Model.ColunaOrdenada("categoria") ? "is-active" : null)" asp-controller="Transactions" asp-action="Index" asp-all-route-data="@Model.RotasOrdenacao("categoria")">
                                    Categoria <span class="wt-th-sort__icon">@Model.IconeOrdenacao("categoria")</span>
                                </a>
                            </th>
                            <th style="text-align:right">
                                <a class="wt-th-sort wt-th-sort--right @(Model.ColunaOrdenada("valor") ? "is-active" : null)" asp-controller="Transactions" asp-action="Index" asp-all-route-data="@Model.RotasOrdenacao("valor")">
                                    Valor <span class="wt-th-sort__icon">@Model.IconeOrdenacao("valor")</span>
                                </a>
                            </th>
                            <th style="text-align:right;width:6.5rem">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Transacoes.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="wt-hint" style="text-align:center;padding:2rem">
                                    Nenhuma transação encontrada. Cadastre a primeira com o botão acima ou ajuste os filtros.
                                </td>
                            </tr>
                        }
                        @foreach (var t in Model.Transacoes)
                        {
                            var badgeClass = t.IsReceita ? "wt-badge--income" : "wt-badge--expense";
                            var numClass = t.IsReceita ? "wt-num--receita" : "wt-num--despesa";
                            var abs = Math.Abs(t.Valor);
                            var formatted = (t.IsReceita ? "+ " : "- ") + "R$ " + abs.ToString("N2");
                            <tr>
                                <td>@t.Data.ToString("dd MMM yyyy")</td>
                                <td>@t.Descricao</td>
                                <td><span class="wt-badge @badgeClass">@t.CategoriaNome</span></td>
                                <td style="text-align:right" class="@numClass">@formatted</td>
                                <td style="text-align:right">
                                    @if (t.Id != Guid.Empty)
                                    {
                                        <div style="display:inline-flex;gap:.25rem;justify-content:flex-end">
                                            <a class="wt-btn wt-btn--ghost"
                                               asp-controller="Transactions" asp-action="Editar"
                                               asp-route-id="@t.Id"
                                               asp-route-OrdenarPor="@Model.OrdenarPor"
                                               asp-route-Ordem="@Model.Ordem"
                                               asp-route-Pag="@Model.Pag"
                                               asp-route-FiltroTipo="@Model.FiltroTipo"
                                               asp-route-FiltroCategoriaId="@Model.FiltroCategoriaId"
                                               asp-route-Busca="@Model.Busca"
                                               title="Editar">✎</a>
                                            <form method="post" asp-controller="Transactions" asp-action="Excluir" asp-route-id="@t.Id" style="display:inline" onsubmit="return confirm('Excluir esta transação?');">
                                                <button type="submit" class="wt-btn wt-btn--ghost" title="Excluir">🗑</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="wt-hint" style="font-size:0.75rem">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="wt-pagination">
                <span>Mostrando @(Model.TotalItens == 0 ? 0 : (Model.Pag - 1) * Model.TamanhoPagina + 1)–@Math.Min(Model.Pag * Model.TamanhoPagina, Model.TotalItens) de @Model.TotalItens transações</span>
                <div class="wt-pagination__nums">
                    @if (Model.Pag > 1)
                    {
                        <a asp-controller="Transactions" asp-action="Index" asp-all-route-data="@Model.RotasPagina(Model.Pag - 1)">←</a>
                    }
                    @for (var i = 1; i <= Model.TotalPaginas && i <= 5; i++)
                    {
                        if (i == Model.Pag)
                        {
                            <span class="wt-page-active">@i</span>
                        }
                        else
                        {
                            <a asp-controller="Transactions" asp-action="Index" asp-all-route-data="@Model.RotasPagina(i)">@i</a>
                        }
                    }
                    @if (Model.Pag < Model.TotalPaginas)
                    {
                        <a asp-controller="Transactions" asp-action="Index" asp-all-route-data="@Model.RotasPagina(Model.Pag + 1)">→</a>
                    }
                </div>
            </div>
        </section>

        <section class="wt-summary-grid">
            <div class="wt-summary-card wt-summary-card--accent">
                <h3>Saldo mensal</h3>
                <p class="wt-big">@Model.ResumoSaldoMensal</p>
                <p class="wt-hint"><span class="wt-trend-up">↑ 12,5%</span> vs mês anterior</p>
            </div>
            <div class="wt-summary-card">
                <h3>Maior gasto</h3>
                <p class="wt-big">@Model.ResumoMaiorGasto</p>
                <p class="wt-hint">Representa 42% do seu orçamento.</p>
            </div>
            <div class="wt-summary-card">
                <h3>Alerta de orçamento</h3>
                <p class="wt-hint">@Model.AlertaOrcamento</p>
            </div>
        </section>
    </div>
</div>

<div class="wt-modal-overlay @(showModal ? "" : "is-hidden")" id="wt-tx-modal">
    <div class="wt-modal" data-wt-stop-propagation="1">
        <form method="post" asp-controller="Transactions" asp-action="Salvar">
            @if (Model.EditingId is Guid editId && editId != Guid.Empty)
            {
                <input type="hidden" asp-for="EditingId" />
                <input type="hidden" asp-for="AccountIdEdicao" />
                <input type="hidden" asp-for="StatusEdicao" />
            }
            <div class="wt-modal__head">
                <div>
                    <h2 class="wt-modal__title">@(Model.ModoEdicao ? "Editar transação" : "Nova transação")</h2>
                    <p class="wt-modal__sub">@(Model.ModoEdicao ? "Altere os dados do lançamento" : "Registro de movimento de capital")</p>
                </div>
                <button type="button" class="wt-modal__close" data-wt-close-modal="1" aria-label="Fechar">×</button>
            </div>
            <div class="wt-form-grid">
                <div class="wt-form-row2">
                    <div>
                        <label class="wt-label" for="tx-data">Data da transação</label>
                        <input class="wt-input" style="width:100%" type="date" id="tx-data" asp-for="Input.Data" />
                    </div>
                    <div>
                        <span class="wt-label">Tipo de transação</span>
                        <div class="wt-segment">
                            <input type="radio" asp-for="Input.TipoTransacao" id="tipo-1" value="1" />
                            <label for="tipo-1">Receita</label>
                            <input type="radio" asp-for="Input.TipoTransacao" id="tipo-2" value="2" />
                            <label for="tipo-2">Despesa</label>
                        </div>
                    </div>
                </div>
                <div>
                    <label class="wt-label" asp-for="Input.Descricao">Descrição do lançamento</label>
                    <input class="wt-input" style="width:100%" asp-for="Input.Descricao" placeholder="Ex: Pagamento consultoria financeira" />
                </div>
                <div class="wt-form-row2">
                    <div>
                        <label class="wt-label" asp-for="Input.PaymentMethodId">Meio de pagamento (opcional)</label>
                        <select class="wt-select" style="width:100%" asp-for="Input.PaymentMethodId">
                            <option value="0">Não informado</option>
                            @foreach (var m in Model.MeiosPagamentoOpcoes)
                            {
                                <option value="@m.Id">@m.Icone @m.Nome</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="wt-label" asp-for="Input.Valor">Valor (R$)</label>
                        <input class="wt-input" style="width:100%" type="number" step="0.01" min="0.01" asp-for="Input.Valor" placeholder="0,00" />
                    </div>
                </div>
                <div>
                    <label class="wt-label" asp-for="Input.CategoryId">Categoria</label>
                    <select class="wt-select" style="width:100%" asp-for="Input.CategoryId">
                        <option value="0">Selecione…</option>
                        @foreach (var c in Model.CategoriasOpcoes)
                        {
                            <option value="@c.Id">@c.Icone @c.Nome</option>
                        }
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(Model.ErroModal))
                {
                    <p class="wt-alert wt-alert--error">@Model.ErroModal</p>
                }
            </div>
            <div class="wt-modal__footer">
                <button type="button" class="wt-btn wt-btn--outline" data-wt-close-modal>Cancelar</button>
                <button type="submit" class="wt-btn wt-btn--primary wt-btn--glow">@(Model.ModoEdicao ? "Salvar alterações" : "Confirmar lançamento")</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/cadastros-wt.js" asp-append-version="true"></script>
}
