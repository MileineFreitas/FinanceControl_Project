@page "/tipos-transacao"
@model FinanceControl.Web.Pages.TiposTransacao.IndexModel
@{
    ViewData["Title"] = "Tipos de transação";
}
@section Styles {
    <link rel="stylesheet" href="~/css/cadastros-wt.css" asp-append-version="true" />
}

<div class="wt-cadastro">
    <div class="wt-cadastro__inner">
        @if (!string.IsNullOrEmpty(Model.ApiMensagem))
        {
            <div class="wt-alert">@Model.ApiMensagem</div>
        }

        <header class="wt-page-head">
            <div>
                <p class="wt-page-kicker">FinanceControl</p>
                <h1 class="wt-page-title">Gerenciar tipos</h1>
                <p class="wt-page-sub">Tipos de fluxo financeiro usados em lançamentos (somente leitura na API).</p>
            </div>
            <button type="button" class="wt-btn wt-btn--primary wt-btn--glow" disabled title="Cadastro via API em evolução">
                + Novo tipo
            </button>
        </header>

        <section class="wt-card-panel">
            <div class="wt-toolbar">
                <div class="wt-search">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(148,163,184,.8)" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke-width="2"/><path d="M20 20l-3-3" stroke-width="2" stroke-linecap="round"/></svg>
                    <input type="search" placeholder="Buscar tipo..." aria-label="Buscar" disabled />
                </div>
                <div style="display:flex;gap:.5rem">
                    <button type="button" class="wt-btn wt-btn--outline" disabled>Filtros</button>
                    <button type="button" class="wt-btn wt-btn--outline" disabled>Exportar</button>
                </div>
            </div>
            <div class="wt-table-wrap">
                <table class="wt-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Status</th>
                            <th style="text-align:right">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Tipos)
                        {
                            <tr>
                                <td>@t.Id</td>
                                <td>@t.Nome</td>
                                <td><span class="wt-badge wt-badge--income">@t.Status</span></td>
                                <td style="text-align:right">
                                    <button type="button" class="wt-btn wt-btn--ghost" disabled title="Somente leitura">✎</button>
                                    <button type="button" class="wt-btn wt-btn--ghost" disabled title="Somente leitura">🗑</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="wt-pagination">
                <span>Mostrando @Model.Tipos.Count tipo(s)</span>
            </div>
        </section>

        <section class="wt-summary-grid">
            <div class="wt-summary-card">
                <h3>Uso típico</h3>
                <p class="wt-hint">RECEITA e DESPESA definem o sentido do valor ao integrar com categorias e relatórios.</p>
            </div>
            <div class="wt-summary-card">
                <h3>API</h3>
                <p class="wt-hint">GET <code style="color:#7dd3fc">/api/TransactionTypes</code></p>
            </div>
        </section>
    </div>
</div>
