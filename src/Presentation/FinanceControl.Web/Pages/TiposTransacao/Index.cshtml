@page "/tipos-transacao"
@model FinanceControl.Web.Pages.TiposTransacao.IndexModel
@{
    ViewData["Title"] = "Meios de pagamento";
    var showModal = Model.ModalAberto || !string.IsNullOrEmpty(Model.ErroModal);
}
@section Styles {
    <link rel="stylesheet" href="~/css/cadastros-wt.css" asp-append-version="true" />
}

<div class="wt-cadastro">
    <div class="wt-cadastro__inner">
        @if (!string.IsNullOrEmpty(Model.ErroPagina))
        {
            <div class="wt-alert wt-alert--error">@Model.ErroPagina</div>
        }
        @if (Model.UsandoDadosDemo)
        {
            <div class="wt-alert">Sem dados da API — exibindo exemplos locais (cadastro e exclusão indisponíveis).</div>
        }

        <header class="wt-page-head">
            <div>
                <p class="wt-page-kicker">FinanceControl</p>
                <h1 class="wt-page-title">Meios de pagamento</h1>
                <p class="wt-page-sub">Cadastre como o valor circula: cartão, PIX, dinheiro, boleto e outros canais. Isso é independente de receita ou despesa — o sentido do lançamento continua na tela de transações.</p>
            </div>
            @if (Model.UsandoDadosDemo)
            {
                <button type="button" class="wt-btn wt-btn--primary wt-btn--glow" disabled title="API indisponível">+ Novo meio</button>
            }
            else
            {
                <button type="button" class="wt-btn wt-btn--primary wt-btn--glow" data-wt-modal-open="wt-meio-modal">+ Novo meio</button>
            }
        </header>

        <div class="wt-cards-grid">
            @if (Model.Meios.Count == 0 && !Model.UsandoDadosDemo)
            {
                <div class="wt-hint" style="grid-column:1/-1;padding:2rem 1rem;text-align:center;border:1px dashed rgba(148,163,184,.35);border-radius:12px;background:rgba(15,23,42,.4)">
                    <p style="margin:0 0 0.5rem;font-weight:600;color:#e2e8f0">Nenhum meio cadastrado ainda</p>
                    <p style="margin:0;font-size:0.875rem">Use <strong>+ Novo meio</strong> ou abra o formulário em <a href="?abrir=novo" style="color:#7dd3fc">tipos-transacao?abrir=novo</a>.</p>
                </div>
            }
            @foreach (var m in Model.Meios)
            {
                <div class="wt-cat-card">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.5rem;margin-bottom:0.5rem">
                        <div class="wt-card-icon">@m.Icone</div>
                        <span class="wt-badge" style="background:rgba(125,211,252,.12);color:#7dd3fc;border-color:rgba(125,211,252,.35)">Canal</span>
                    </div>
                    <div class="wt-card-name">@m.Nome</div>
                    @if (!string.IsNullOrWhiteSpace(m.Descricao))
                    {
                        <p class="wt-hint" style="margin:0.35rem 0 0;font-size:0.8rem;line-height:1.35">@m.Descricao</p>
                    }
                    @if (m.PaymentMethodId is int mid && mid > 0)
                    {
                        <form method="post" asp-page-handler="DeletePaymentMethod" asp-route-id="@mid" style="margin-top:0.75rem" onsubmit="return confirm('Excluir este meio de pagamento?');">
                            <button type="submit" class="wt-btn wt-btn--outline" style="width:100%;font-size:0.75rem;padding:0.4rem">Excluir</button>
                        </form>
                    }
                </div>
            }
        </div>

        <div class="wt-bottom-grid">
            <div class="wt-summary-card wt-summary-card--accent">
                <h3>Receita e despesa</h3>
                <p class="wt-hint">O tipo de fluxo (entrada ou saída) define-se em cada transação. Esta tela organiza apenas o <strong>meio</strong> usado no pagamento ou recebimento.</p>
            </div>

            @if (Model.UsandoDadosDemo)
            {
                <button type="button" class="wt-add-card" style="border:0;font:inherit;width:100%" disabled>
                    <div style="font-size:1.75rem;line-height:1;color:#7dd3fc">＋</div>
                    <div style="font-weight:600;color:#e2e8f0">Adicionar meio</div>
                    <div class="wt-hint" style="text-align:center">Cartão corporativo, PIX da conta, etc.</div>
                </button>
            }
            else
            {
                <button type="button" class="wt-add-card" data-wt-modal-open="wt-meio-modal" style="border:0;font:inherit;width:100%">
                    <div style="font-size:1.75rem;line-height:1;color:#7dd3fc">＋</div>
                    <div style="font-weight:600;color:#e2e8f0">Adicionar meio</div>
                    <div class="wt-hint" style="text-align:center">Cartão corporativo, PIX da conta, etc.</div>
                </button>
            }
        </div>
    </div>
</div>

<div class="wt-modal-overlay @(showModal ? null : "is-hidden")" id="wt-meio-modal" aria-hidden="@((!showModal).ToString().ToLower())">
    <div class="wt-modal" data-wt-stop-propagation role="dialog" aria-modal="true" aria-labelledby="wt-meio-modal-title">
        <form method="post" asp-page-handler="CreatePaymentMethod">
            <div class="wt-modal__head">
                <div>
                    <h2 class="wt-modal__title" id="wt-meio-modal-title">Cadastrar meio de transação</h2>
                    <p class="wt-modal__sub">Nomeie o canal de pagamento ou recebimento (cartão, PIX, dinheiro…). Receita e despesa continuam na tela de transações.</p>
                </div>
                <button class="wt-modal__close" type="button" data-wt-close-modal aria-label="Fechar">✕</button>
            </div>
            <div class="wt-form-grid">
                <div>
                    <label class="wt-label" asp-for="PaymentMethodInput.Name">Nome do meio</label>
                    <input class="wt-input" style="width:100%" type="text" asp-for="PaymentMethodInput.Name" placeholder="Ex.: Cartão corporativo final 9012, PIX da conta PJ…" autocomplete="off" data-wt-modal-focus maxlength="120" />
                </div>
                <div>
                    <label class="wt-label" asp-for="PaymentMethodInput.Description">Descrição (opcional)</label>
                    <input class="wt-input" style="width:100%" type="text" asp-for="PaymentMethodInput.Description" placeholder="Ex.: Final 1234, conta corrente principal" autocomplete="off" />
                </div>
                <div>
                    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:0.5rem;margin-bottom:0.4rem">
                        <span class="wt-label" style="margin:0">Ícone</span>
                        <span style="font-size:0.6rem;font-weight:600;letter-spacing:0.14em;color:rgba(148,163,184,0.75)">@Model.IconesDisponiveis.Count DISPONÍVEIS</span>
                    </div>
                    <div class="wt-icone-grid">
                        @foreach (var icone in Model.IconesDisponiveis)
                        {
                            var sel = Model.SelectedIcon == icone;
                            <label class="wt-icone-btn @(sel ? "wt-icone-btn--selected" : null)">
                                <input class="wt-visually-hidden" type="radio" name="SelectedIcon" value="@icone" @(sel ? "checked" : null) />
                                @icone
                            </label>
                        }
                    </div>
                    <p class="wt-hint" style="margin-top:0.5rem">O ícone é só visual na lista (o cadastro na API usa nome e descrição).</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.ErroModal))
                {
                    <p class="wt-alert wt-alert--error">@Model.ErroModal</p>
                }
            </div>
            <div class="wt-modal__footer">
                <button type="button" class="wt-btn wt-btn--outline" data-wt-close-modal>Cancelar</button>
                <button type="submit" class="wt-btn wt-btn--primary wt-btn--glow">Salvar meio</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/cadastros-wt.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var overlay = document.getElementById('wt-meio-modal');
            if (!overlay || overlay.classList.contains('is-hidden')) return;
            var el = overlay.querySelector('[data-wt-modal-focus]');
            if (el) setTimeout(function () { try { el.focus(); } catch (e) { } }, 10);
        });
    </script>
}
